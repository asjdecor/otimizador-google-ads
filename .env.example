# Banco (arquivo SQLite local)
DATABASE_URL="file:./dados.db"

# Chave de 32 bytes em base64 para criptografar o refresh token.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Google Cloud → APIs e serviços → Credenciais (OAuth "Aplicativo da Web")
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# Google Ads → conta gerente (MCC) → Ferramentas → Central de API
GOOGLE_ADS_DEVELOPER_TOKEN=""
# ID da MCC sem traços (opcional)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

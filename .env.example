# Banco (arquivo SQLite local)
DATABASE_URL="file:./dados.db"

# Chave de 32 bytes em base64 para criptografar o refresh token.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=""

# Google Cloud → APIs e serviços → Credenciais (OAuth "Aplicativo da Web").
# O nível de acesso à Google Ads API (Teste/Explorer/Básico) vem do projeto onde este cliente OAuth foi criado.
# Não existe mais developer token (descontinuado pelo Google em 09/09/2026): não adicione GOOGLE_ADS_DEVELOPER_TOKEN.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google/callback"

# MCC usada como login-customer-id para ler as contas filhas (opcional; com ou sem traços)
GOOGLE_ADS_LOGIN_CUSTOMER_ID=""

# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

# Login por senha (alternativa ao login Google). Gere com:
#   npm run gerar-senha -- "sua senha forte"
APP_SENHA_HASH=""
# Login Google de usuário único: e-mail permitido. Para usar este modo, deixe APP_SENHA_HASH vazio.
APP_EMAIL_AUTORIZADO=""
# Chave aleatória com pelo menos 32 caracteres; usada para assinar a sessão do app.
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SESSAO_SEGREDO=""

# Só na Vercel: a integração Neon cria estas duas sozinha (o DATABASE_URL de cima vira o do Neon).
# DATABASE_URL_UNPOOLED=""
